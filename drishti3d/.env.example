# Drishti3D environment configuration (copy to .env and adjust)

# --- Backend ---
DRISHTI_HOST=127.0.0.1              # bind locally by default (offline-friendly)
DRISHTI_PORT=8000
DRISHTI_DATA_DIR=./data             # projects, uploads, artifacts, sqlite db
DRISHTI_MAX_UPLOAD_MB=2048
DRISHTI_CORS=http://localhost:5173,http://127.0.0.1:5173

# Path to a built frontend (served at / in production). Leave default to use
# frontend/dist after `npm run build`.
# DRISHTI_FRONTEND_DIST=./frontend/dist

# --- Optional AI backends (never auto-downloaded) ---
# DRISHTI_MAST3R_PATH=/opt/MASt3R-SLAM
# DRISHTI_VGGT_PATH=/opt/vggt
# DRISHTI_SEG_WEIGHTS=/opt/weights/deeplabv3_seg.pth   # for semantic masking

# --- Frontend (dev) ---
# VITE_API_BASE=                     # empty -> use Vite proxy to the backend
